  ],
  "rules": [
    {
      "prefixes": [
        "client/",
        "tests/",
        "server/",
        "package.json",
        "package-lock.json",
        "vite.config.js",
        "scripts/",
        "verification/"
      ],
      "groups": ["unit", "browser"]
    },
    {
      "prefixes": ["hub/"],
      "groups": ["go"]
    },
    {
      "prefixes": ["hub/internal/store/"],
      "groups": ["migration"]
    },
    {
      "prefixes": ["wasm/"],
      "groups": ["wasm", "unit", "browser"]
    },
    {
      "prefixes": [
        "docs/",
        "AGENTS.md",
        "README.md",
        ".gitignore",
        "LICENSE",
        "Dockerfile",
        ".github/",
        ".prettierignore",
        ".prettierrc",
        "index.html",
        "public/"
      ],
      "groups": ["unit"]
    }
  ]
}
