tailterm.tailarr.com {
    root * /srv/tailserve
    encode zstd gzip
    header {
        Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; connect-src 'self' https: wss:; font-src 'self'; img-src 'self' data:; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'"
        Referrer-Policy "no-referrer"
        X-Content-Type-Options "nosniff"
        Permissions-Policy "camera=(), microphone=(), geolocation=(), clipboard-read=(self), clipboard-write=(self)"
        Cache-Control "no-cache"
    }
    @assets path /assets/*
    header @assets Cache-Control "public, max-age=31536000, immutable"
    file_server {
        precompressed br gzip
    }
}
